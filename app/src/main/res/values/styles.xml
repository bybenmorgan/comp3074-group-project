<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Household.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/dashboard_sage</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.Household.FeatureButton" parent="Widget.Material3.Button.IconButton.Filled">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:clickable">false</item>
        <item name="cornerRadius">28dp</item>
        <item name="iconSize">28dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconTint">@color/dashboard_text</item>
        <item name="strokeColor">@color/dashboard_cream</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="TextAppearance.Household.Heading" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">serif</item>
        <item name="fontFamily">serif</item>
        <item name="android:textColor">@color/dashboard_text</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.Household.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/dashboard_text</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.Household.Caption" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/dashboard_text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="ThemeOverlay.Household.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/dashboard_outline</item>
        <item name="colorOnPrimary">@color/dashboard_cream</item>
        <item name="colorSurface">@color/dashboard_cream</item>
        <item name="colorOnSurface">@color/dashboard_text</item>
        <item name="android:background">@color/dashboard_cream</item>
    </style>

    <style name="Widget.Household.ListItem" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:drawableStart">@drawable/ic_notice_bullet</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Household.Body</item>
    </style>
</resources>
