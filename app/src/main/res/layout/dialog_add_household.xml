<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <EditText
        android:id="@+id/household_name_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_status_row"
        android:hint="@string/household_name_hint"
        android:importantForAutofill="no"
        android:inputType="textCapWords"
        android:minHeight="52dp"
        android:padding="12dp"
        android:textAppearance="@style/TextAppearance.Household.Body"
        android:textColor="@color/dashboard_text"
        android:textColorHint="@color/dashboard_text_secondary" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/household_include_pet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:checked="true"
        android:minHeight="48dp"
        android:padding="8dp"
        android:text="@string/household_include_pet"
        android:textAppearance="@style/TextAppearance.Household.Body"
        android:textColor="@color/dashboard_text" />

    <EditText
        android:id="@+id/household_pet_name_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_status_row"
        android:hint="@string/household_pet_name_hint"
        android:importantForAutofill="no"
        android:inputType="textCapWords"
        android:minHeight="52dp"
        android:padding="12dp"
        android:text="@string/pet_name"
        android:textAppearance="@style/TextAppearance.Household.Body"
        android:textColor="@color/dashboard_text"
        android:textColorHint="@color/dashboard_text_secondary" />
</LinearLayout>
