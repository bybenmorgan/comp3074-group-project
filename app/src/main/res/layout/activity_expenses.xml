<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/expenses_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dashboard_cream"
    android:fillViewport="true"
    tools:context=".ExpensesActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dashboard"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Household.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="28dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="88dp"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:accessibilityHeading="true"
                        android:text="@string/dashboard_title"
                        android:textAppearance="@style/TextAppearance.Household.Heading"
                        android:textSize="25sp"
                        android:textStyle="normal" />

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Household.Card"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:cardBackgroundColor="@color/dashboard_lavender"
                        app:cardCornerRadius="24dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/profile_placeholder"
                            android:padding="12dp"
                            app:srcCompat="@drawable/ic_profile" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Household.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:padding="16dp"
                        android:text="@string/expenses_title"
                        android:textAppearance="@style/TextAppearance.Household.Heading" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_status_row"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/expenses_you_owe"
                                android:textAppearance="@style/TextAppearance.Household.Heading"
                                android:textSize="20sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/expenses_balance"
                                android:textAppearance="@style/TextAppearance.Household.Heading"
                                android:textSize="38sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_expenses" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/add_expense"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="16dp"
                        android:clickable="false"
                        android:minHeight="56dp"
                        android:text="@string/expenses_add"
                        android:textAppearance="@style/TextAppearance.Household.Heading"
                        android:textColor="@color/dashboard_text"
                        android:textSize="20sp"
                        app:backgroundTint="@color/dashboard_cream"
                        app:cornerRadius="16dp"
                        app:icon="@drawable/ic_add_expense"
                        app:iconGravity="textStart"
                        app:iconTint="@null"
                        app:strokeColor="@color/dashboard_outline"
                        app:strokeWidth="1dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:orientation="vertical"
                    android:paddingTop="16dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/feature_dashboard"
                        style="@style/Widget.Household.FeatureButton"
                        android:contentDescription="@string/return_to_dashboard"
                        app:backgroundTint="@color/dashboard_cream"
                        app:icon="@drawable/ic_dashboard" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/feature_chores"
                        style="@style/Widget.Household.FeatureButton"
                        android:layout_marginTop="16dp"
                        android:contentDescription="@string/feature_chores"
                        app:backgroundTint="@color/dashboard_muted_green"
                        app:icon="@drawable/ic_chores" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/feature_groceries"
                        style="@style/Widget.Household.FeatureButton"
                        android:layout_marginTop="16dp"
                        android:contentDescription="@string/feature_groceries"
                        app:backgroundTint="@color/dashboard_blush"
                        app:icon="@drawable/ic_groceries" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/feature_pet_care"
                        style="@style/Widget.Household.FeatureButton"
                        android:layout_marginTop="16dp"
                        android:contentDescription="@string/feature_pet_care"
                        app:backgroundTint="@color/dashboard_taupe"
                        app:icon="@drawable/ic_pet" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/feature_expenses"
                        style="@style/Widget.Household.FeatureButton"
                        android:layout_marginTop="16dp"
                        android:contentDescription="@string/feature_expenses_current"
                        app:backgroundTint="@color/dashboard_yellow"
                        app:icon="@drawable/ic_expenses"
                        app:strokeColor="@color/dashboard_outline"
                        app:strokeWidth="2dp" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Household.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:accessibilityHeading="true"
                            android:background="@drawable/bg_status_row"
                            android:padding="12dp"
                            android:text="@string/expenses_recent"
                            android:textAppearance="@style/TextAppearance.Household.Heading" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_status_row"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:drawableStart="@drawable/ic_internet"
                                android:drawablePadding="8dp"
                                android:gravity="center_vertical"
                                android:text="@string/expense_internet"
                                android:textAppearance="@style/TextAppearance.Household.Body" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="4dp"
                                    android:layout_weight="1"
                                    android:text="@string/expense_internet_amount"
                                    android:textAppearance="@style/TextAppearance.Household.Body" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/expense_internet_date"
                                    android:textAppearance="@style/TextAppearance.Household.Caption" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/expense_paid_by_ben"
                                android:textAppearance="@style/TextAppearance.Household.Caption" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_status_row"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:drawableStart="@drawable/ic_groceries"
                                android:drawablePadding="8dp"
                                android:gravity="center_vertical"
                                android:text="@string/expense_groceries"
                                android:textAppearance="@style/TextAppearance.Household.Body" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="4dp"
                                    android:layout_weight="1"
                                    android:text="@string/expense_groceries_amount"
                                    android:textAppearance="@style/TextAppearance.Household.Body" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/expense_groceries_date"
                                    android:textAppearance="@style/TextAppearance.Household.Caption" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/expense_paid_by_hannah"
                                android:textAppearance="@style/TextAppearance.Household.Caption" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_status_row"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:drawableStart="@drawable/ic_rent"
                                android:drawablePadding="8dp"
                                android:gravity="center_vertical"
                                android:text="@string/expense_rent"
                                android:textAppearance="@style/TextAppearance.Household.Body" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="4dp"
                                    android:layout_weight="1"
                                    android:text="@string/expense_rent_amount"
                                    android:textAppearance="@style/TextAppearance.Household.Body" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/expense_rent_date"
                                    android:textAppearance="@style/TextAppearance.Household.Caption" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/expense_paid_by_hannah"
                                android:textAppearance="@style/TextAppearance.Household.Caption" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_status_row"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:drawableStart="@drawable/ic_pet"
                                android:drawablePadding="8dp"
                                android:gravity="center_vertical"
                                android:text="@string/expense_pet_supplies"
                                android:textAppearance="@style/TextAppearance.Household.Body" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="4dp"
                                    android:layout_weight="1"
                                    android:text="@string/expense_pet_supplies_amount"
                                    android:textAppearance="@style/TextAppearance.Household.Body" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/expense_pet_supplies_date"
                                    android:textAppearance="@style/TextAppearance.Household.Caption" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/expense_paid_by_ben"
                                android:textAppearance="@style/TextAppearance.Household.Caption" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
