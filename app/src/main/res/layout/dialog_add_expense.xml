<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <EditText
        android:id="@+id/expense_title_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_status_row"
        android:hint="@string/expense_title_hint"
        android:importantForAutofill="no"
        android:inputType="textCapSentences"
        android:minHeight="52dp"
        android:padding="12dp"
        android:textAppearance="@style/TextAppearance.Household.Body"
        android:textColor="@color/dashboard_text"
        android:textColorHint="@color/dashboard_text_secondary" />

    <EditText
        android:id="@+id/expense_amount_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_status_row"
        android:hint="@string/expense_amount_hint"
        android:importantForAutofill="no"
        android:inputType="numberDecimal"
        android:minHeight="52dp"
        android:padding="12dp"
        android:textAppearance="@style/TextAppearance.Household.Body"
        android:textColor="@color/dashboard_text"
        android:textColorHint="@color/dashboard_text_secondary" />

    <TextView
        android:id="@+id/expense_due_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_status_row"
        android:clickable="true"
        android:contentDescription="@string/expense_choose_due"
        android:focusable="true"
        android:gravity="center_vertical"
        android:hint="@string/expense_due_hint"
        android:minHeight="52dp"
        android:padding="12dp"
        android:textAppearance="@style/TextAppearance.Household.Body"
        android:textColor="@color/dashboard_text"
        android:textColorHint="@color/dashboard_text_secondary" />

    <Spinner
        android:id="@+id/expense_payer_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_status_row"
        android:contentDescription="@string/expense_select_payer"
        android:minHeight="52dp"
        android:padding="12dp"
        android:textAppearance="@style/TextAppearance.Household.Body"
        android:textColor="@color/dashboard_text"
        android:textColorHint="@color/dashboard_text_secondary" />

    <TextView
        android:id="@+id/expense_payer_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/expense_select_payer"
        android:textAppearance="@style/TextAppearance.Household.Caption"
        android:visibility="gone" />
</LinearLayout>
