<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/create_join_household_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dashboard_cream"
    tools:context=".CreateJoinHouseholdActivity">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:padding="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dashboard"
                android:orientation="vertical"
                android:paddingBottom="16dp">
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Household.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="28dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:gravity="center_vertical"
                        android:minHeight="88dp"
                        android:padding="16dp"
                        android:text="@string/dashboard_title"
                        android:textAppearance="@style/TextAppearance.Household.Heading"
                        android:textSize="25sp" />
                </com.google.android.material.card.MaterialCardView>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="24dp"
                    android:accessibilityHeading="true"
                    android:text="@string/household_setup_title"
                    android:textAppearance="@style/TextAppearance.Household.Heading" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/household_setup_intro"
                    android:textAppearance="@style/TextAppearance.Household.Body" />
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Household.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="24dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:accessibilityHeading="true"
                            android:text="@string/create_household"
                            android:textAppearance="@style/TextAppearance.Household.Heading" />
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/household_name_layout"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:hint="@string/household_name"
                            app:boxBackgroundColor="@color/dashboard_cream"
                            app:boxCornerRadiusBottomEnd="16dp"
                            app:boxCornerRadiusBottomStart="16dp"
                            app:boxCornerRadiusTopEnd="16dp"
                            app:boxCornerRadiusTopStart="16dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/household_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionDone"
                                android:inputType="textCapWords"
                                android:maxLines="1"
                                android:textAppearance="@style/TextAppearance.Household.Body" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/create_household"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:minHeight="56dp"
                            android:text="@string/create_household"
                            android:textAppearance="@style/TextAppearance.Household.Heading"
                            android:textColor="@color/dashboard_text"
                            android:textSize="20sp"
                            app:backgroundTint="@color/dashboard_cream"
                            app:cornerRadius="16dp"
                            app:strokeColor="@color/dashboard_outline"
                            app:strokeWidth="1dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/dashboard_outline"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="16dp"
                        android:text="@string/household_setup_or"
                        android:textAppearance="@style/TextAppearance.Household.Caption" />
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/dashboard_outline"
                        android:importantForAccessibility="no" />
                </LinearLayout>
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Household.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:accessibilityHeading="true"
                            android:text="@string/join_household"
                            android:textAppearance="@style/TextAppearance.Household.Heading" />
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/invite_code_layout"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:hint="@string/invite_code"
                            app:boxBackgroundColor="@color/dashboard_cream"
                            app:boxCornerRadiusBottomEnd="16dp"
                            app:boxCornerRadiusBottomStart="16dp"
                            app:boxCornerRadiusTopEnd="16dp"
                            app:boxCornerRadiusTopStart="16dp"
                            app:helperText="@string/invite_code_helper"
                            app:helperTextTextAppearance="@style/TextAppearance.Household.Caption">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/invite_code"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionDone"
                                android:inputType="textNoSuggestions"
                                android:maxLines="1"
                                android:textAppearance="@style/TextAppearance.Household.Body" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/join_household"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:minHeight="56dp"
                            android:text="@string/join_household"
                            android:textAppearance="@style/TextAppearance.Household.Heading"
                            android:textColor="@color/dashboard_text"
                            android:textSize="20sp"
                            app:backgroundTint="@color/dashboard_cream"
                            app:cornerRadius="16dp"
                            app:strokeColor="@color/dashboard_outline"
                            app:strokeWidth="1dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
